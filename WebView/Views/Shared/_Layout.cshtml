<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebView</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebView.styles.css" asp-append-version="true" />
    <style>
        button{
            border: none;
            background-color: none;

        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar bg-black">
            <a class="navbar-brand fs-3 text-white" asp-area="" asp-controller="Home" asp-action="Index">WebView</a>
            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            <a class="nav-link text-white" asp-area="" asp-controller="FoodController" asp-action="CustomerList">Foods</a>
            </ul>
            <div class="btn-group float-end">
                <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    Account @* TODO: Use ViewBag here *@
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button class="dropdown-item" type="button">Profile</button></li>
                    <li><button class="dropdown-item" type="button">Dark Mode</button></li>
                    <li><button class="dropdown-item" type="button">Log out</button></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - WebView - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
